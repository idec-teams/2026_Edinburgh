</style>

<script>
  // ── Char-by-char heading ────────────────────────────────────
  (function() {
    const el = document.getElementById('vex-heading');
    if (!el) return;
    const text = 'One enzyme.\nTwo real activities.';
    const CHAR_DELAY = 30;
    const lines = text.split('\n');
    el.innerHTML = lines.map(function(line, li) {
      return '<span class="block">' +
        line.split('').map(function(ch, ci) {
          const delay = (li * line.length * CHAR_DELAY) + (ci * CHAR_DELAY);
          return '<span class="char" style="transition-delay:' + delay + 'ms">' +
            (ch === ' ' ? '&nbsp;' : ch) + '</span>';
        }).join('') +
        '</span>';
    }).join('');
    setTimeout(function() { el.classList.add('animated'); }, 200);
  })();

  // ── Staggered fade-ins (Beat 1) ─────────────────────────────
  (function() {
    const items = [
      { el: document.getElementById('vex-para'),    delay: 800  },
      { el: document.getElementById('vex-buttons'), delay: 1200 },
      { el: document.getElementById('vex-pill'),    delay: 1400 },
    ];
    items.forEach(function(item) {
      if (!item.el) return;
      setTimeout(function() { item.el.classList.add('visible'); }, item.delay);
    });
  })();

  // ── Magnetic square ─────────────────────────────────────────
  (function() {
    const sq = document.getElementById('magnet-square');
    if (!sq) return;
    let near = false;
    const STRENGTH = 20, PAD = 100;
    window.addEventListener('mousemove', function(e) {
      const r = sq.getBoundingClientRect();
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      const isNear = Math.abs(e.clientX - cx) < r.width / 2 + PAD &&
                   Math.abs(e.clientY - cy) < r.height / 2 + PAD;
      if (isNear) {
        near = true;
        sq.style.transition = 'transform 0.3s ease-out';
        sq.style.transform = 'rotate(9deg) translate3d(' +
          ((e.clientX - cx) / STRENGTH) + 'px,' +
          ((e.clientY - cy) / STRENGTH) + 'px,0)';
      } else if (near) {
        near = false;
        sq.style.transition = 'transform 0.6s ease-in-out';
        sq.style.transform = 'rotate(9deg) translate3d(0,0,0)';
      }
    });
  })();

  // ── Lithos spotlight ────────────────────────────────────────
  (function() {
    const section  = document.getElementById('lithos-hero');
    const canvas   = document.getElementById('lithos-canvas') as HTMLCanvasElement | null;
    const reveal   = document.getElementById('lithos-reveal') as HTMLElement | null;
    if (!section || !canvas || !reveal) return;
    const RADIUS   = 260;
    const mouse    = { x: -999, y: -999 };
    const smooth   = { x: -999, y: -999 };

    function resize() {
      canvas!.width  = section!.offsetWidth;
      canvas!.height = section!.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    window.addEventListener('mousemove', function(e) {
      const r = section!.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    });

    function tick() {
      smooth.x += (mouse.x - smooth.x) * 0.1;
      smooth.y += (mouse.y - smooth.y) * 0.1;

      const ctx = canvas!.getContext('2d')!;
      ctx.clearRect(0, 0, canvas!.width, canvas!.height);

      const g = ctx.createRadialGradient(smooth.x, smooth.y, 0, smooth.x, smooth.y, RADIUS);
      g.addColorStop(0,    'rgba(255,255,255,1)');
      g.addColorStop(0.4,  'rgba(255,255,255,1)');
      g.addColorStop(0.6,  'rgba(255,255,255,0.75)');
      g.addColorStop(0.75, 'rgba(255,255,255,0.4)');
      g.addColorStop(0.88, 'rgba(255,255,255,0.12)');
      g.addColorStop(1,    'rgba(255,255,255,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(smooth.x, smooth.y, RADIUS, 0, Math.PI * 2);
      ctx.fill();

      const url = canvas!.toDataURL();
      reveal!.style.maskImage        = 'url(' + url + ')';
      (reveal!.style as any).webkitMaskImage = 'url(' + url + ')';
      reveal!.style.maskSize         = '100% 100%';
      (reveal!.style as any).webkitMaskSize  = '100% 100%';

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();

  // ── Beat 3: scroll-driven domain reveal ─────────────────────
  (function() {
    const section = document.getElementById('beat3');
    const eyebrow = document.getElementById('b3-eyebrow');
    const heading = document.getElementById('b3-heading');
    const svgWrap = document.getElementById('b3-svg-wrap');
    const cexDom = document.getElementById('b3-cex-dom');
    const cexHelix = document.getElementById('b3-cex-helix') as unknown as SVGElement;
    const labCex = document.getElementById('b3-lab-cex');
    const labCexSub = document.getElementById('b3-lab-cex-sub');
    const cbmDom  = document.getElementById('b3-cbm-dom');
    const labCbm  = document.getElementById('b3-lab-cbm');
    const labCbmSub = document.getElementById('b3-lab-cbm-sub');
    const cenaDom  = document.getElementById('b3-cena-dom');
    const cenaHelix = document.getElementById('b3-cena-helix') as unknown as SVGElement;
    const labCena  = document.getElementById('b3-lab-cena');
    const labCenaSub = document.getElementById('b3-lab-cena-sub');
    const cardCex = document.getElementById('b3-card-cex');
    const cardCbm  = document.getElementById('b3-card-cbm');
    const cardCena  = document.getElementById('b3-card-cena');
    const final    = document.getElementById('b3-final');
    if (!section || !eyebrow || !heading || !svgWrap || !final) return;

    function clamp(v: number, a: number, b: number) { return Math.max(a, Math.min(b, v)); }
    function mapRange(v: number, i0: number, i1: number, o0: number, o1: number) {
      return o0 + (o1 - o0) * clamp((v - i0) / (i1 - i0), 0, 1);
    }

    const state = { cex: false, cbm: false, cena: false };

    function lit(el: Element | null, on: boolean) {
      if (!el) return;
      if (on) el.classList.add('lit');
      else    el.classList.remove('lit');
    }

    function tick() {
      const rect = section!.getBoundingClientRect();
      const totalScroll = section!.offsetHeight - window.innerHeight;
      const p = clamp(-rect.top / totalScroll, 0, 1);

      // Eyebrow + heading: 0–0.15
      const headOp = mapRange(p, 0, 0.12, 0, 1);
      (eyebrow as HTMLElement).style.opacity = String(headOp);
      (eyebrow as HTMLElement).style.transform = 'translateY(' + mapRange(p, 0, 0.12, 16, 0) + 'px)';
      (heading as HTMLElement).style.opacity = String(headOp);
      (heading as HTMLElement).style.transform = 'translateY(' + mapRange(p, 0, 0.12, 20, 0) + 'px)';

      // SVG fades in: 0.05–0.2
      (svgWrap as HTMLElement).style.opacity = String(mapRange(p, 0.05, 0.2, 0, 1));

      // Cex: 0.2–0.45
      const cexOn = p >= 0.2;
      if (cexOn !== state.cex) {
        state.cex = cexOn;
        lit(cexDom, cexOn);
        lit(labCex, cexOn);
        lit(labCexSub, cexOn);
        lit(cardCex, cexOn);
        if (cexHelix) cexHelix.style.opacity = cexOn ? '1' : '0';
      }

      // CBM: 0.45–0.65
      const cbmOn = p >= 0.45;
      if (cbmOn !== state.cbm) {
        state.cbm = cbmOn;
        lit(cbmDom, cbmOn);
        lit(labCbm, cbmOn);
        lit(labCbmSub, cbmOn);
        lit(cardCbm, cbmOn);
      }

      // CenA: 0.65–0.85
      const cenaOn = p >= 0.65;
      if (cenaOn !== state.cena) {
        state.cena = cenaOn;
        lit(cenaDom, cenaOn);
        lit(labCena, cenaOn);
        lit(labCenaSub, cenaOn);
        lit(cardCena, cenaOn);
        if (cenaHelix) cenaHelix.style.opacity = cenaOn ? '1' : '0';
      }

      // Final text: 0.85–1.0
      (final as HTMLElement).style.opacity = String(mapRange(p, 0.85, 1.0, 0, 1));

      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();

  // ── Beat 4: stagger reveal on scroll ───────────────────────
  (function() {
    const eyebrow = document.getElementById('b4-eyebrow');
    const heading = document.getElementById('b4-heading');
    const footer  = document.getElementById('b4-footer');
    const cards   = document.querySelectorAll('.b4-card');
    const beat4   = document.getElementById('beat4');
    if (!eyebrow || !heading || !footer || !beat4) return;

    const io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const delay = parseInt(el.dataset.b4Delay || '0', 10);
        setTimeout(function() { el.classList.add('visible'); }, delay);
        io.unobserve(el);
      });
    }, { threshold: 0.15 });

    const headerIo = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        eyebrow!.classList.add('visible');
        heading!.classList.add('visible');
        footer!.classList.add('visible');
        headerIo.disconnect();
      });
    }, { threshold: 0.2 });

    headerIo.observe(beat4);
    cards.forEach(function(card) { io.observe(card); });
  })();

  // ── Beat 3: scroll-scrubbed WebP background ─────────────────
  (function() {
    const WEBP_URL = import.meta.env.BASE_URL.replace(/\/$/, '') + '/helix-spin.webp';
    const section = document.getElementById('beat3');
    const imgEl   = document.getElementById('b3-webp-img') as HTMLImageElement | null;
    const canvas  = document.getElementById('b3-webp-canvas') as HTMLCanvasElement | null;
    if (!canvas || !section || !imgEl) return;

    const ctx = canvas.getContext('2d')!;
    let frames: ImageBitmap[] = [];
    let scrubReady = false;

    function clampF(v: number, a: number, b: number) { return Math.max(a, Math.min(b, v)); }

    function resize() {
      canvas!.width  = window.innerWidth;
      canvas!.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    function drawCover(frame: ImageBitmap) {
      const cw = canvas!.width, ch = canvas!.height;
      const fW = frame.width,  fH = frame.height;
      const ca = cw / ch, fa = fW / fH;
      let sx = 0, sy = 0, sw = fW, sh = fH;
      if (ca > fa) { sh = fW / ca; sy = (fH - sh) / 2; }
      else         { sw = fH * ca; sx = (fW - sw) / 2; }
      ctx.drawImage(frame, sx, sy, sw, sh, 0, 0, cw, ch);
    }

    function decodeAll(decoder: any, total: number, idx: number, bitmaps: ImageBitmap[], done: (b: ImageBitmap[]) => void) {
      if (idx >= total) { done(bitmaps); return; }
      decoder.decode({ frameIndex: idx })
        .then(function(result: any) {
          return createImageBitmap(result.image).then(function(bmp: ImageBitmap) {
            result.image.close();
            bitmaps.push(bmp);
            decodeAll(decoder, total, idx + 1, bitmaps, done);
          });
        })
        .catch(function() { done(bitmaps); });
    }

    if (typeof (window as any).ImageDecoder !== 'undefined') {
      fetch(WEBP_URL)
        .then(function(r) { return r.arrayBuffer(); })
        .then(function(buf) {
          const dec = new (window as any).ImageDecoder({ data: buf, type: 'image/webp' });
          return dec.tracks.ready.then(function() {
            const track = dec.tracks.selectedTrack;
            const total = (track && track.frameCount) || 0;
            if (total <= 1) { dec.close(); return; }
            decodeAll(dec, total, 0, [], function(bitmaps) {
              if (bitmaps.length > 1) {
                frames = bitmaps;
                scrubReady = true;
                canvas!.style.opacity = '0.55';
                imgEl!.style.opacity  = '0';
              }
              dec.close();
            });
          });
        })
        .catch(function(e) { console.warn('[Beat3 WebP]', e); });
    }

    let lastIdx = -1;
    function tickWebp() {
      if (scrubReady && frames.length > 0) {
        const rect = section!.getBoundingClientRect();
        const totalScroll = section!.offsetHeight - window.innerHeight;
        const p   = clampF(-rect.top / totalScroll, 0, 1);
        const idx = clampF(Math.round(p * (frames.length - 1)), 0, frames.length - 1);
        if (idx !== lastIdx) {
          ctx.clearRect(0, 0, canvas!.width, canvas!.height);
          if (frames[idx]) drawCover(frames[idx]);
          lastIdx = idx;
        }
      }
      requestAnimationFrame(tickWebp);
    }
    tickWebp();
  })();
</script>

<script>
  import * as THREE from 'three';

  const el = document.getElementById('hero-canvas-container') as HTMLElement | null;

  if (
    !el ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    window.innerWidth <= 860
  ) {
    // nothing
  } else {
    initMolecule(el);
  }

  function initMolecule(container: HTMLElement): void {
    const W = container.clientWidth  || 800;
    const H = container.clientHeight || 460;

    // Scene
    const scene  = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(55, W / H, 0.1, 100);
    camera.position.z = 8;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(W, H);
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);
    requestAnimationFrame(() => container.classList.add('loaded'));

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.18));

    // Sky-blue key light (illuminates Cex from upper-left)
    const cexLight = new THREE.PointLight(0x7dd3fc, 3.5, 28);
    cexLight.position.set(-2, 5, 8);
    scene.add(cexLight);

    // Green fill light (illuminates CenA from lower-right)
    const cenaLight = new THREE.PointLight(0x3dd68c, 3.0, 24);
    cenaLight.position.set(11, -3, 7);
    scene.add(cenaLight);

    // White top fill
    const fLight = new THREE.PointLight(0xffffff, 1.0, 32);
    fLight.position.set(4, 9, 10);
    scene.add(fLight);

    // Mouse-following lamp -- the interactive circle of influence.
    // Projects cursor world-space position on z=0, illuminates nearby spheres.
    const mouseLamp = new THREE.PointLight(0xffffff, 0, 10, 1.5);
    scene.add(mouseLamp);

    // Shared geometry + dummy
    const geo   = new THREE.SphereGeometry(1, 9, 7);
    const dummy = new THREE.Object3D();

    // Sphere cluster -- surface-biased random packing
    type Sp = { x: number; y: number; z: number; r: number };

    function cluster(cx: number, cy: number, cz: number, radius: number, n: number): Sp[] {
      const out: Sp[] = [];
      while (out.length < n) {
        const theta = Math.random() * Math.PI * 2;
        const phi   = Math.acos(2 * Math.random() - 1);
        const r     = radius * (0.38 + 0.62 * Math.cbrt(Math.random())); // bias toward surface
        out.push({
          x: cx + r * Math.sin(phi) * Math.cos(theta),
          y: cy + r * Math.sin(phi) * Math.sin(theta),
          z: cz + r * Math.cos(phi) * 0.78,  // slightly flattened in z
          r: 0.13 + Math.random() * 0.22,    // larger spheres for hero-scale visibility
        });
      }
      return out;
    }

    // Centres: Cex (sky-blue, left) -- CenA (green, right). Two real, confirmed domains.
    const CEX_C  = [-2.5, 0.5, 0] as const;
    const CENA_C = [ 2.5, -0.5, 0] as const;

    const cexAll  = cluster(CEX_C[0],  CEX_C[1],  CEX_C[2],  2.4, 180);
    const cenaAll = cluster(CENA_C[0], CENA_C[1], CENA_C[2], 2.2, 160);

    // Linker -- quadratic bezier arc
    const linker: Sp[] = Array.from({ length: 32 }, (_, i) => {
      const t = i / 31, mt = 1 - t;
      return {
        x: mt*mt * CEX_C[0] + 2*mt*t * 0   + t*t * CENA_C[0],
        y: mt*mt * CEX_C[1] + 2*mt*t * 1.0 + t*t * CENA_C[1],
        z: mt*mt * CEX_C[2] + 2*mt*t * 0.4 + t*t * CENA_C[2],
        r: 0.08 + Math.random() * 0.06,
      };
    });

    // Near-linker spheres on each domain, picked out for a subtle extra highlight --
    // both pulse the same way; neither implies "this is the evolving one" (that nuance
    // belongs on the Science/Results pages, not a generic identity hero).
    const topNIdx = (arr: Sp[], sign: 1 | -1, n: number): Set<number> =>
      new Set(arr.map((s, i) => ({ i, v: s.x * sign }))
        .sort((a, b) => b.v - a.v).slice(0, n).map(e => e.i));

    const cexAIdx  = topNIdx(cexAll, 1, 9);
    const cenaAIdx = topNIdx(cenaAll, -1, 9);

    const cexReg  = cexAll.filter((_, i) => !cexAIdx.has(i));
    const cexAct  = cexAll.filter((_, i) =>  cexAIdx.has(i));
    const cenaReg = cenaAll.filter((_, i) => !cenaAIdx.has(i));
    const cenaAct = cenaAll.filter((_, i) =>  cenaAIdx.has(i));

    // Materials -- sky-blue / green: high contrast on dark green bg
    const mCex   = new THREE.MeshPhongMaterial({ color: 0x7dd3fc, emissive: 0x0c3a52, shininess: 80 });
    const mCena  = new THREE.MeshPhongMaterial({ color: 0x3dd68c, emissive: 0x0d3a26, shininess: 80 });
    const mLink  = new THREE.MeshPhongMaterial({
      color: 0xd0f0ff, emissive: 0x224466, shininess: 25, transparent: true, opacity: 0.42,
    });
    const mCexA  = new THREE.MeshPhongMaterial({
      color: 0xbae6fd, emissive: 0x7dd3fc, emissiveIntensity: 0.7, shininess: 140,
    });
    const mCenaA = new THREE.MeshPhongMaterial({
      color: 0x86efac, emissive: 0x3dd68c, emissiveIntensity: 0.7, shininess: 140,
    });

    // Build InstancedMeshes (one draw call per material)
    function buildMesh(spheres: Sp[], mat: THREE.MeshPhongMaterial): THREE.InstancedMesh {
      const m = new THREE.InstancedMesh(geo, mat, spheres.length);
      m.frustumCulled = false;
      spheres.forEach((s, i) => {
        dummy.position.set(s.x, s.y, s.z);
        dummy.scale.setScalar(s.r);
        dummy.updateMatrix();
        m.setMatrixAt(i, dummy.matrix);
      });
      m.instanceMatrix.needsUpdate = true;
      return m;
    }

    const meshCex   = buildMesh(cexReg,  mCex);
    const meshCena  = buildMesh(cenaReg, mCena);
    const meshLink  = buildMesh(linker,  mLink);
    const meshCexA  = buildMesh(cexAct,  mCexA);
    const meshCenaA = buildMesh(cenaAct, mCenaA);

    const group = new THREE.Group();
    group.add(meshCex, meshCena, meshLink, meshCexA, meshCenaA);
    // Shift molecule into right ~60% of the hero; text sits in the left half
    group.position.x = 3.5;
    scene.add(group);

    // Mouse tracking (NDC). Listen on the hero section so .vex-content (which sits
    // above the canvas) doesn't block events -- events on siblings bubble up to the
    // parent section.
    const mouse = new THREE.Vector2(9999, 9999);
    const heroSection = container.closest('section') ?? container;
    heroSection.addEventListener('mousemove', e => {
      const rect = container.getBoundingClientRect();
      mouse.set(
        ((e.clientX - rect.left) / rect.width)  *  2 - 1,
        ((e.clientY - rect.top)  / rect.height) * -2 + 1,
      );
    });
    heroSection.addEventListener('mouseleave', () => mouse.set(9999, 9999));

    // Pre-allocated -- avoid per-frame GC pressure
    const _ray        = new THREE.Vector3();
    const _mouseWorld = new THREE.Vector3();

    // Animation loop
    const clock = new THREE.Clock();
    let raf = 0;

    function tick(): void {
      raf = requestAnimationFrame(tick);
      const t = clock.getElapsedTime();

      // Slow auto-rotation + gentle wobble
      group.rotation.y = t * 0.065;
      group.rotation.x = Math.sin(t * 0.035) * 0.07;

      // Mouse lamp: project NDC cursor into world space (z = 0 plane). Creates a
      // smooth sphere of influence: nearest spheres light up, periphery fades
      // naturally via the PointLight's distance falloff.
      if (mouse.x < 100) {
        _ray.set(mouse.x, mouse.y, 0.5).unproject(camera).sub(camera.position).normalize();
        const tHit = -camera.position.z / _ray.z;
        _mouseWorld.copy(camera.position).addScaledVector(_ray, tHit);
        mouseLamp.position.copy(_mouseWorld);
        mouseLamp.intensity = 8;
      } else {
        mouseLamp.intensity = 0;
      }

      // Near-linker emissive pulse -- same rhythm on both domains
      const p1 = 0.5 + 0.5 * Math.sin(t * 1.3);
      const p2 = 0.5 + 0.5 * Math.sin(t * 1.3 + 0.7);
      mCexA.emissiveIntensity  = 0.35 + p1 * 0.85;
      mCenaA.emissiveIntensity = 0.35 + p2 * 0.85;

      renderer.render(scene, camera);
    }
    tick();

    // Resize observer
    const ro = new ResizeObserver(() => {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (!w || !h) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });
    ro.observe(container);

    // Cleanup on Astro view transitions
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      renderer.dispose();
      ro.disconnect();
    }, { once: true });
  }
</script>
