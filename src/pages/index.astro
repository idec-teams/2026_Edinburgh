---
import BaseLayout from '../layouts/BaseLayout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="TriCel — CxnA Directed Evolution | iDEC 2026"
  description="Engineering a bifunctional cellulose-degrading enzyme toward a third activity via directed evolution. An iDEC 2026 research project combining AlphaFold3 structural analysis with wet-lab molecular biology."
>
  <div class="v2-root">

    <!-- ── Section 1: VEX HERO ────────────────────── -->
    <section id="vex-hero" aria-label="CxnA overview">
      <!-- Desktop: interactive Three.js molecule (Cex + CenA). Mobile: static photo below. -->
      <div class="hero-3d" id="hero-canvas-container" aria-hidden="true"></div>
      <div id="magnet-square" aria-hidden="true"></div>

      <div class="vex-content">
        <div class="vex-grid">
          <div>
            <h1 class="vex-h1" id="vex-heading" aria-label="One enzyme. Two real activities."></h1>
            <p class="vex-para" id="vex-para">
              Engineering a bifunctional cellulase toward a third activity —
              Cex (GH10) and CenA (GH6) fused into one chain.
            </p>
            <div class="vex-buttons" id="vex-buttons">
              <a href={`${b}/science`} class="btn-primary">Read the Science</a>
              <a href={`${b}/results`} class="btn-glass liquid-glass">View Results</a>
            </div>
          </div>
          <div class="vex-pill-wrap" id="vex-pill">
            <div class="vex-pill liquid-glass">Cex (GH10) · CBM · CenA (GH6)</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Section 2: LITHOS HERO ─────────────────── -->
    <section id="lithos-hero" aria-label="Cellulose to glucose">
      <div id="lithos-base" class="hero-zoom" aria-hidden="true"></div>
      <canvas id="lithos-canvas" aria-hidden="true"></canvas>
      <div id="lithos-reveal" aria-hidden="true"></div>

      <div class="lithos-heading">
        <h1>
          <span class="lithos-h-italic hero-anim hero-reveal" style="animation-delay:0.25s">Cellulose to</span>
          <span class="lithos-h-plain hero-anim hero-reveal" style="animation-delay:0.42s">glucose.</span>
        </h1>
      </div>

      <div class="lithos-bl hero-anim hero-fade" style="animation-delay:0.7s">
        <p>Plant cell walls are the planet's most abundant carbon store. CxnA was engineered to break them down — two real catalytic domains fused into one protein chain.</p>
      </div>

      <div class="lithos-br hero-anim hero-fade" style="animation-delay:0.85s">
        <p>Move your cursor to reveal the living material we're engineering a future from — guided by directed evolution and structural biology.</p>
        <a href={`${b}/results`} class="btn-lithos">Explore Results</a>
      </div>
    </section>

    <!-- ── Section 3: BEAT 3 — Mechanism ──────────── -->
    <section id="beat3" aria-label="How CxnA works">
      <div id="beat3-sticky">
        <!-- Animated WebP fallback — always visible until canvas takes over -->
        <img id="b3-webp-img" src={`${b}/helix-spin.webp`} alt="" aria-hidden="true" />
        <!-- Canvas receives scroll-scrubbed frames via ImageDecoder -->
        <canvas id="b3-webp-canvas" aria-hidden="true"></canvas>
        <div id="b3-mol-overlay" aria-hidden="true"></div>
        <div id="b3-content">

        <p class="b3-eyebrow" id="b3-eyebrow" style="opacity:0">Mechanism</p>

        <h2 class="b3-heading" id="b3-heading" style="opacity:0;transform:translateY(20px)">
          Two real enzymes.<br><em>One chain.</em>
        </h2>

        <!-- Protein domain SVG diagram -->
        <div class="b3-svg-wrap" id="b3-svg-wrap" style="opacity:0">
          <svg viewBox="0 0 700 160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Backbone -->
            <line x1="40" y1="80" x2="660" y2="80" class="b3-backbone" />

            <!-- Cex domain (left, larger) -->
            <rect id="b3-cex-dom" x="40" y="32" width="220" height="96" rx="48"
                  class="b3-domain b3-cex-shape" />
            <!-- Internal helix zigzag decoration -->
            <polyline id="b3-cex-helix" points="70,60 90,100 110,60 130,100 150,60 170,100 190,60 210,100 230,60"
                      stroke="rgba(61,214,140,0.35)" stroke-width="2" fill="none" opacity="0"
                      style="transition:opacity 0.7s 0.2s" />
            <text x="150" y="24" text-anchor="middle" class="b3-svg-label b3-svg-domain-name" id="b3-lab-cex">Cex</text>
            <text x="150" y="152" text-anchor="middle" class="b3-svg-label b3-svg-sublabel" id="b3-lab-cex-sub">GH10 · Exoglucanase</text>

            <!-- CBM/Linker (centre, smaller) -->
            <rect id="b3-cbm-dom" x="290" y="50" width="120" height="60" rx="30"
                  class="b3-domain b3-cbm-shape" />
            <text x="350" y="24" text-anchor="middle" class="b3-svg-label b3-svg-domain-name" id="b3-lab-cbm">CBM</text>
            <text x="350" y="152" text-anchor="middle" class="b3-svg-label b3-svg-sublabel" id="b3-lab-cbm-sub">Carbohydrate-Binding</text>

            <!-- CenA domain (right, larger) -->
            <rect id="b3-cena-dom" x="440" y="32" width="220" height="96" rx="48"
                  class="b3-domain b3-cena-shape" />
            <polyline id="b3-cena-helix" points="470,60 490,100 510,60 530,100 550,60 570,100 590,60 610,100 630,60"
                      stroke="rgba(61,214,140,0.35)" stroke-width="2" fill="none" opacity="0"
                      style="transition:opacity 0.7s 0.2s" />
            <text x="550" y="24" text-anchor="middle" class="b3-svg-label b3-svg-domain-name" id="b3-lab-cena">CenA</text>
            <text x="550" y="152" text-anchor="middle" class="b3-svg-label b3-svg-sublabel" id="b3-lab-cena-sub">GH6 · Endoglucanase</text>

            <!-- Linker connector lines (dim always visible) -->
            <line x1="260" y1="80" x2="290" y2="80" stroke="rgba(255,255,255,0.12)" stroke-width="2" stroke-dasharray="4 4"/>
            <line x1="410" y1="80" x2="440" y2="80" stroke="rgba(255,255,255,0.12)" stroke-width="2" stroke-dasharray="4 4"/>
          </svg>
        </div>

        <!-- Domain info cards -->
        <div class="b3-cards">
          <div class="b3-card b3-card-cex" id="b3-card-cex">
            <div class="b3-card-name">Cex — GH10</div>
            <p>Exoglucanase. Attacks crystalline cellulose from chain ends, releasing the disaccharide cellobiose.</p>
          </div>
          <div class="b3-card b3-card-cbm" id="b3-card-cbm">
            <div class="b3-card-name">CBM · Linker</div>
            <p>Carbohydrate-Binding Module anchors CxnA to the substrate surface, increasing local enzyme concentration.</p>
          </div>
          <div class="b3-card b3-card-cena" id="b3-card-cena">
            <div class="b3-card-name">CenA — GH6</div>
            <p>Endoglucanase. Cleaves internal bonds, creating new chain ends for Cex to attack — the two domains work in relay.</p>
          </div>
        </div>

        <p class="b3-final" id="b3-final" style="opacity:0">
          Two confirmed cellulose-degrading activities, fused into <strong>a single engineered protein chain</strong>.
        </p>

        </div><!-- /#b3-content -->
      </div>
    </section>

    <!-- ── Section 4: BEAT 4 — Bento grid ─────────── -->
    <section id="beat4" aria-label="Explore the project">
      <div class="b4-container">
        <p class="b4-eyebrow" id="b4-eyebrow">iDEC 2026</p>
        <h2 class="b4-heading" id="b4-heading">Explore the project</h2>

        <div class="b4-grid">
          <!-- Science — large card -->
          <a href={`${b}/science`} class="b4-card b4-card--large" data-b4-delay="0">
            <div>
              <div class="b4-card-tag">Science</div>
            </div>
            <div>
              <h3 class="b4-card-title">Why cellulose is the hardest problem in green chemistry — and how a bifunctional enzyme is being pushed further.</h3>
              <div class="b4-card-arrow">→</div>
            </div>
          </a>

          <!-- Methods -->
          <a href={`${b}/methods`} class="b4-card" data-b4-delay="100">
            <div>
              <div class="b4-card-tag">Methods</div>
            </div>
            <div>
              <h3 class="b4-card-title">Directed evolution protocol — dry-lab to wet-lab pipeline.</h3>
              <div class="b4-card-arrow">→</div>
            </div>
          </a>

          <!-- Results -->
          <a href={`${b}/results`} class="b4-card" data-b4-delay="200">
            <div>
              <div class="b4-card-tag">Results</div>
            </div>
            <div>
              <h3 class="b4-card-title">Structural models, binding analysis &amp; activity assays.</h3>
              <div class="b4-card-arrow">→</div>
            </div>
          </a>

          <!-- Notebook -->
          <a href={`${b}/notebook`} class="b4-card" data-b4-delay="300">
            <div>
              <div class="b4-card-tag">Notebook</div>
            </div>
            <div>
              <h3 class="b4-card-title">Lab diary — week-by-week experimental record.</h3>
              <div class="b4-card-arrow">→</div>
            </div>
          </a>

          <!-- Overview -->
          <a href={`${b}/overview`} class="b4-card" data-b4-delay="400">
            <div>
              <div class="b4-card-tag">Overview</div>
            </div>
            <div>
              <h3 class="b4-card-title">Plain-language project summary — what we built and why.</h3>
              <div class="b4-card-arrow">→</div>
            </div>
          </a>
        </div>

        <div class="b4-footer" id="b4-footer">
          <p>Competing at iDEC 2026 · Affiliated with the International Directed Evolution Competition</p>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ── Root wrapper. No overflow-x here: it would establish a new
     containing block and break position:sticky in #beat3-sticky. Each
     section clips its own overflow (rotated square / scaled photo) instead. */
  .v2-root {
    letter-spacing: -0.02em;
    background: var(--c-bg);
    color: #fff;
  }
  :global([data-theme="light"] .v2-root) { color: #111; }

  /* ── Liquid-glass utility ───────────────────────── */
  .liquid-glass {
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.1);
    position: relative;
    overflow: hidden;
  }
  .liquid-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.4px;
    background: linear-gradient(180deg,
      rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 20%,
      rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%,
      rgba(255,255,255,0.1) 80%, rgba(255,255,255,0.3) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  :global([data-theme="light"] .liquid-glass ) { background: rgba(255,255,255,0.65); box-shadow: inset 0 1px 1px rgba(0,0,0,0.06); }
  :global([data-theme="light"] .liquid-glass::before) {
    background: linear-gradient(180deg,
      rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.02) 20%,
      transparent 40%, transparent 60%,
      rgba(0,0,0,0.02) 80%, rgba(0,0,0,0.08) 100%);
  }

  /* ── VEX HERO ───────────────────────────────────── */
  #vex-hero {
    position: relative;
    min-height: 100dvh;
    background: var(--c-bg);
    overflow: hidden;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  /* Desktop hero: interactive Three.js molecule (full-section background layer) */
  .hero-3d {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    display: none;
    transition: opacity 1.1s ease;
  }
  .hero-3d.loaded { opacity: 1; }
  .hero-3d canvas { display: block; }
  @media (min-width: 861px) {
    .hero-3d { display: block; }
  }
  /* Mobile fallback: static rotated photo (no WebGL cost on mobile) */
  #magnet-square {
    display: none;
    position: absolute;
    top: 50%; left: 50%;
    width: min(600px, 90vw);
    height: min(600px, 90vw);
    margin-top: calc(min(600px, 90vw) / -2);
    margin-left: calc(min(600px, 90vw) / -2);
    background:
      linear-gradient(rgba(0,0,12,0.28), rgba(0,0,12,0.28)),
      url('https://images.unsplash.com/photo-1714844437236-de8ef1c7286f?w=1200&q=80') center/cover;
    border-radius: 16px;
    transform: rotate(9deg);
    pointer-events: none;
    will-change: transform;
  }
  @media (max-width: 860px) {
    #magnet-square { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-3d { display: none; }
    #magnet-square { display: block; }
  }
  .vex-content {
    flex: 1;
    display: flex;
    align-items: flex-end;
    padding: 0 24px 48px;
  }
  @media (min-width: 768px) { .vex-content { padding: 0 48px 64px; } }
  @media (min-width: 1024px) { .vex-content { padding: 0 64px 64px; } }
  .vex-grid {
    width: 100%;
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .vex-grid { grid-template-columns: 1fr 1fr; align-items: end; }
  }
  .vex-h1 {
    color: inherit;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 16px;
  }
  .vex-h1 :global(.block) { display: block; }
  .vex-h1 :global(.char) {
    display: inline-block;
    opacity: 0;
    transform: translateX(-18px);
    transition: opacity 500ms, transform 500ms;
  }
  .vex-h1.animated :global(.char) { opacity: 1; transform: translateX(0); }

  .vex-para {
    font-size: 1rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
    max-width: 40ch;
    opacity: 0;
    transition: opacity 1s;
  }
  @media (min-width: 768px) { .vex-para { font-size: 1.125rem; } }
  .vex-para.visible { opacity: 1; }
  :global([data-theme="light"] .vex-para ) { color: rgba(0,0,0,0.6); }

  .vex-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    opacity: 0;
    transition: opacity 1s;
  }
  .vex-buttons.visible { opacity: 1; }
  .btn-primary {
    background: #fff;
    color: #000;
    border: none;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    padding: 12px 32px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-primary:hover { background: #e5e5e5; text-decoration: none; }
  :global([data-theme="light"] .btn-primary ) { background: #111; color: #fff; }
  :global([data-theme="light"] .btn-primary:hover ) { background: #333; }
  .btn-glass {
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 500;
    padding: 12px 32px;
    border-radius: 8px;
    cursor: pointer;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-glass:hover { background: #fff; color: #000; text-decoration: none; }
  :global([data-theme="light"] .btn-glass ) { border-color: rgba(0,0,0,0.18); color: #111; background: rgba(255,255,255,0.55); }
  :global([data-theme="light"] .btn-glass:hover ) { background: #111; color: #fff; }

  .vex-pill-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    opacity: 0;
    transition: opacity 1s;
  }
  @media (min-width: 1024px) { .vex-pill-wrap { justify-content: flex-end; } }
  .vex-pill-wrap.visible { opacity: 1; }
  .vex-pill {
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 12px;
    padding: 12px 24px;
    font-size: 1.25rem;
    font-weight: 300;
  }
  @media (min-width: 768px) { .vex-pill { font-size: 1.5rem; } }
  :global([data-theme="light"] .vex-pill ) { border-color: rgba(0,0,0,0.15); color: #111; }
  :global([data-theme="light"] #vex-hero ) { background: var(--c-bg); }
  :global([data-theme="light"] #magnet-square ) { filter: brightness(1.08) saturate(0.85); }

  /* ── LITHOS HERO ────────────────────────────────── */
  #lithos-hero {
    position: relative;
    width: 100%;
    height: 100dvh;
    background: #000;
    overflow: hidden;
    scroll-snap-align: start;
  }
  #lithos-base {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1657573100558-c15355cc9c49?w=1920&q=80');
    background-size: cover;
    background-position: center;
    z-index: 1;
  }
  #lithos-reveal {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1709651808265-977ed7ef78c6?w=1920&q=80');
    background-size: cover;
    background-position: center;
    z-index: 3;
    pointer-events: none;
  }
  #lithos-canvas { position: absolute; inset: 0; display: none; }

  .lithos-heading {
    position: absolute;
    top: 14%;
    left: 0; right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 20px;
    pointer-events: none;
    z-index: 5;
  }
  .lithos-heading h1 {
    color: #fff;
    line-height: 0.95;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .lithos-h-italic {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: -0.05em;
    display: block;
  }
  .lithos-h-plain {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: -0.08em;
    display: block;
    margin-top: -4px;
  }

  .lithos-bl {
    position: absolute;
    bottom: 56px;
    left: 40px;
    max-width: 260px;
    z-index: 5;
    display: none;
  }
  @media (min-width: 640px) { .lithos-bl { display: block; } }
  .lithos-bl p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
  }

  .lithos-br {
    position: absolute;
    bottom: 40px;
    right: 20px;
    left: 20px;
    max-width: 260px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    z-index: 5;
  }
  @media (min-width: 640px) {
    .lithos-br { left: auto; right: 56px; bottom: 96px; }
  }
  .lithos-br p {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
  }
  .btn-lithos {
    background: var(--c-accent);
    color: #000;
    border: none;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 12px 28px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, filter 0.2s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-lithos:hover { filter: brightness(1.1); transform: scale(1.03); text-decoration: none; }
  .btn-lithos:active { transform: scale(0.95); }

  /* ── Keyframe animations ────────────────────────── */
  @keyframes heroReveal {
    0%   { opacity: 0; transform: translateY(28px); filter: blur(12px); }
    100% { opacity: 1; transform: translateY(0);    filter: blur(0); }
  }
  @keyframes heroFadeUp {
    0%   { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroZoom {
    0%   { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  .hero-anim {
    opacity: 0;
    animation-fill-mode: forwards;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-reveal { animation-name: heroReveal; animation-duration: 1.1s; }
  .hero-fade   { animation-name: heroFadeUp; animation-duration: 1s; }
  .hero-zoom   { animation: heroZoom 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  @media (prefers-reduced-motion: reduce) {
    .hero-anim, .hero-zoom { animation: none; opacity: 1; }
    .vex-h1 :global(.char) { opacity: 1; transform: none; }
  }

  /* ── BEAT 3: Mechanism ──────────────────────────── */
  #beat3 {
    height: 300vh;
    scroll-snap-align: start;
  }
  #beat3-sticky {
    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;
    background: var(--c-bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
  :global([data-theme="light"] #beat3-sticky ) { background: var(--c-bg); }
  .b3-eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--c-primary);
    margin-bottom: 20px;
    transition: opacity 0.8s, transform 0.8s;
  }
  .b3-heading {
    color: inherit;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    text-align: center;
    line-height: 1.08;
    margin-bottom: 52px;
    transition: opacity 0.8s, transform 0.8s;
  }
  .b3-heading em {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--c-primary);
  }

  /* SVG protein domain diagram */
  .b3-svg-wrap {
    width: min(700px, 90vw);
    margin-bottom: 32px;
    transition: opacity 0.8s;
  }
  .b3-backbone {
    stroke: rgba(255,255,255,0.15);
    stroke-width: 3;
    fill: none;
  }
  :global([data-theme="light"] .b3-backbone ) { stroke: rgba(0,0,0,0.15); }
