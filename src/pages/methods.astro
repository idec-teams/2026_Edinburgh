          <text x="125" y="112" text-anchor="middle" font-size="9" fill="#a8d5bc" font-family="system-ui,sans-serif">Structure prediction</text>
          <text x="125" y="124" text-anchor="middle" font-size="8.5" fill="#7ec9a6" font-family="system-ui,sans-serif">Cex + CenA</text>

          <path d="M200,100 L228,100" stroke="#1a6648" stroke-width="2" marker-end="url(#pa)" fill="none"/>

          <rect x="230" y="72" width="150" height="56" rx="8" fill="#1a6648"/>
          <text x="305" y="97" text-anchor="middle" font-size="10" fill="white" font-family="system-ui,sans-serif" font-weight="600">Docking + PLIP</text>
          <text x="305" y="112" text-anchor="middle" font-size="9" fill="#a8d5bc" font-family="system-ui,sans-serif">Cellobiose / cellotetraose</text>
