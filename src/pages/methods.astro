          <text x="105" y="246" text-anchor="middle" font-size="9.5" fill="white" font-family="system-ui,sans-serif" font-weight="600">culture</text>
          <text x="105" y="259" text-anchor="middle" font-size="8.5" fill="#f0c070" font-family="system-ui,sans-serif">WL-1, WL-2</text>

          <path d="M160,238 L186,238" stroke="#c9862a" stroke-width="2" marker-end="url(#pb)" fill="none"/>

