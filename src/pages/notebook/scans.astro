---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const scansDir = path.join(process.cwd(), 'public', 'images', 'notebook-scans');
const files = fs.existsSync(scansDir)
  ? fs.readdirSync(scansDir)
      .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
      .sort((a, c) => a.localeCompare(c, undefined, { numeric: true }))
  : [];
const srcs = files.map((f) => `${b}/images/notebook-scans/${f}`);
---

<BaseLayout
  title="Lab Notebook — Scanned Pages | TriCel CxnA"
  description="Photographed pages from the physical lab notebook, kept as the raw record alongside the dated digital notebook entries."
>
  <div class="page-hero">
    <div class="container">
      <p class="page-eyebrow">Research record</p>
      <h1>Scanned Notebook Pages</h1>
      <p class="page-lead">
        Photographs of the physical lab notebook, kept here as the raw record. Many pages
        couldn't be reliably matched to a date or to a specific entry in the
        <a href={`${b}/notebook`}>dated notebook</a>, so they're presented here as-is —
        unsorted, not transcribed — rather than forced into a chronology that isn't
        verifiable.
      </p>
      <p class="page-lead">
        This is a parallel record, not a duplicate of the dated notebook — the two don't
        fully cover each other. Some material here may not appear in a dated entry, and
        some dated entries may not have a corresponding photographed page.
      </p>
    </div>
  </div>

  <main id="main" class="container scans-page">
    {files.length === 0 ? (
      <div class="placeholder-block">
        <div class="placeholder-icon" aria-hidden="true">📔</div>
        <p>Scans not uploaded yet — check back soon.</p>
      </div>
    ) : (
      <>
        <p class="scans-count">{files.length} photographed page{files.length === 1 ? '' : 's'}</p>
        <div class="scans-grid">
          {files.map((f, i) => (
            <button type="button" class="scan-thumb" data-index={i} aria-label={`Open page ${i + 1} of ${files.length}`}>
              <img src={srcs[i]} alt={`Scanned notebook page ${i + 1}`} loading="lazy" />
            </button>
          ))}
        </div>
      </>
    )}
  </main>

  <div class="scan-lightbox" id="scan-lightbox" hidden>
    <button type="button" class="scan-lightbox-close" id="scan-lightbox-close" aria-label="Close">✕</button>
    <button type="button" class="scan-lightbox-nav scan-lightbox-prev" id="scan-lightbox-prev" aria-label="Previous page">‹</button>
    <img class="scan-lightbox-img" id="scan-lightbox-img" src="" alt="" />
    <button type="button" class="scan-lightbox-nav scan-lightbox-next" id="scan-lightbox-next" aria-label="Next page">›</button>
    <div class="scan-lightbox-counter" id="scan-lightbox-counter" aria-live="polite"></div>
  </div>
</BaseLayout>

<style>
  .scans-page { padding-block: var(--sp-10); }
  .scans-count { color: var(--c-text-muted); margin-bottom: var(--sp-5); }

  .scans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--sp-3);
  }
  .scan-thumb {
    padding: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--c-surface);
    cursor: pointer;
    aspect-ratio: 3 / 4;
    display: block;
  }
  .scan-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .scan-thumb:hover, .scan-thumb:focus-visible {
    border-color: var(--c-primary);
    outline: none;
  }

  .scan-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .scan-lightbox[hidden] { display: none; }
  .scan-lightbox-img {
    max-width: min(92vw, 1100px);
    max-height: 88vh;
    object-fit: contain;
  }
  .scan-lightbox-close, .scan-lightbox-nav {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .scan-lightbox-close:hover, .scan-lightbox-nav:hover { background: rgba(255, 255, 255, 0.2); }
  .scan-lightbox-close { top: var(--sp-5); right: var(--sp-5); }
  .scan-lightbox-prev { left: var(--sp-5); top: 50%; transform: translateY(-50%); }
  .scan-lightbox-next { right: var(--sp-5); top: 50%; transform: translateY(-50%); }
  .scan-lightbox-counter {
    position: absolute;
    bottom: var(--sp-5);
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .scans-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); }
    .scan-lightbox-prev { left: var(--sp-2); }
    .scan-lightbox-next { right: var(--sp-2); }
  }
</style>

<script define:vars={{ srcs }}>
  const lightbox = document.getElementById('scan-lightbox');
  const lightboxImg = document.getElementById('scan-lightbox-img');
  const counter = document.getElementById('scan-lightbox-counter');
  const closeBtn = document.getElementById('scan-lightbox-close');
  const prevBtn = document.getElementById('scan-lightbox-prev');
  const nextBtn = document.getElementById('scan-lightbox-next');
  let current = 0;

  function show(i) {
    if (!srcs.length) return;
    current = (i + srcs.length) % srcs.length;
    lightboxImg.src = srcs[current];
    lightboxImg.alt = `Scanned notebook page ${current + 1}`;
    counter.textContent = `${current + 1} / ${srcs.length}`;
  }

  document.querySelectorAll('.scan-thumb').forEach((btn) => {
    btn.addEventListener('click', () => {
      show(Number(btn.dataset.index));
      lightbox.hidden = false;
    });
  });

  closeBtn?.addEventListener('click', () => { lightbox.hidden = true; });
  prevBtn?.addEventListener('click', () => show(current - 1));
  nextBtn?.addEventListener('click', () => show(current + 1));
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.hidden = true;
  });
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') lightbox.hidden = true;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
