---
import BaseLayout from '../layouts/BaseLayout.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, "");

const team = [
  { name: 'Chloe Muller', major: 'Wet lab', photoSrc: `${b}/images/team/member-1.jpg` },
  { name: 'Emma Gregson', major: 'Wet lab', photoSrc: `${b}/images/team/member-2.jpg` },
  { name: 'Esther Tulloch', major: 'Wet lab · Team lead', photoSrc: `${b}/images/team/member-3.jpg` },
  { name: 'Chester Chan', major: 'Wet lab & dry lab', photoSrc: `${b}/images/team/member-4.webp` },
  { name: 'Alexander Gottel', major: 'Wet lab & dry lab', photoSrc: `${b}/images/team/member-5.jpg` },
  { name: 'Tank Li', major: 'Wet lab & dry lab', photoSrc: `${b}/images/team/member-6.jpg` },
];

const supervisors = [
  { name: 'Heather Barker', major: 'Project Supervisor and Advisor', photoSrc: `${b}/images/team/supervisor-heather.webp` },
  { name: 'Chris French', major: 'Project Advisor', photoSrc: `${b}/images/team/supervisor-chris-french.jpg` },
];

const members = ['Esther', 'Chloe', 'Emma', 'Alex', 'Chester', 'Tank'];

const attribution = [
  { stage: 'Initial Culturing, Miniprep and Sequencing', desc: 'Prepare DNA and analyse the native sequence.', lab: 'Wet lab', scores: [5, 5, 0, 0, 0, 0] },
  { stage: 'Enzyme Characterisation and Construct Validation', desc: 'Test native enzyme functionality and codon-optimised construct performance.', lab: 'Wet lab', scores: [2, 5, 4, 4, 0, 3] },
  { stage: 'Selection and Assay Validation', desc: 'Test selection methods and validate experimental controls.', lab: 'Wet lab', scores: [3, 3, 3, 3, 1, 3] },
  { stage: 'PCR Optimisation and Construct Assembly', desc: 'Troubleshoot high-GC PCR, perform ePCR and high-fidelity backbone PCR, and assemble native and codon-optimised constructs using Gibson Assembly.', lab: 'Wet lab', scores: [4, 3, 4, 3, 5, 4] },
  { stage: 'Mutant Library Generation and Screening', desc: 'Grow the mutant library and screen for promising variants.', lab: 'Wet lab', scores: [5, 5, 2, 2, 3, 5] },
  { stage: 'Mutant Activity Characterisation', desc: 'Perform activity assays to evaluate the functionality of selected mutants.', lab: 'Wet lab', scores: [5, 0, 0, 0, 0, 5] },
  { stage: 'Protein Structure Prediction and Validation', desc: 'Generate AlphaFold/ColabFold models of CxnA and its CenA and Cex domains, and compare predicted structures with known crystal structures to validate catalytic residues.', lab: 'Dry lab', scores: [0, 0, 0, 3, 5, 2] },
  { stage: 'Integration of Computational Findings with Experimental Screening', desc: 'Use structural and computational predictions to guide experimental mutant selection, then compare predicted substrate interactions with the Congo red, X-gluc and MUC assay results and their respective DNA sequences.', lab: 'Dry lab', scores: [1, 0, 0, 4, 5, 4] },
];
---

<BaseLayout
  title="Team — TriCel CxnA | iDEC 2026"
  description="The people behind the CxnA directed evolution project — iDEC 2026, University of Edinburgh."
>

  <!-- ═══ PAGE HERO ═══ -->
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Team</p>
      <h1>The people behind this project</h1>
      <p>
        iDEC 2026, University of Edinburgh.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="team-grid">
        {team.map((member) => (
          <div class="team-card card">
            {member.photoSrc ? (
              <img src={member.photoSrc} alt={member.name ?? 'Team member'} class="team-photo" />
            ) : (
              <div class="team-photo team-photo--placeholder" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/></svg>
              </div>
            )}
            <h3 class="team-name">{member.name ?? 'Name pending'}</h3>
            <p class="team-major">{member.major ?? 'Role / major pending'}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Supervision</p>
        <h2>Supervisors</h2>
      </div>
      <div class="team-grid team-grid--supervisors">
        {supervisors.map((member) => (
          <div class="team-card card">
            {member.photoSrc ? (
              <img src={member.photoSrc} alt={member.name ?? 'Supervisor'} class="team-photo" />
            ) : (
              <div class="team-photo team-photo--placeholder" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.5-7 8-7s8 3 8 7"/></svg>
              </div>
            )}
            <h3 class="team-name">{member.name ?? 'Name pending'}</h3>
            <p class="team-major">{member.major ?? 'Role pending'}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ ATTRIBUTION TABLE ═══ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Contributions</p>
        <h2>Attribution by project stage</h2>
        <p>Self-reported contribution out of 5 for each stage of the project.</p>
      </div>
      <div class="table-wrap"><div class="table-scroll">
        <table class="data-table attribution-table">
          <thead>
            <tr>
              <th>Stage</th>
              {members.map((m) => <th>{m}</th>)}
            </tr>
          </thead>
          <tbody>
            {attribution.map((row) => (
              <tr>
                <td>
                  <strong>{row.stage}</strong>
                  <span class="attribution-desc">{row.desc}</span>
                  <span class="badge badge--sm">{row.lab}</span>
                </td>
                {row.scores.map((s) => <td class="mono attribution-score">{s}/5</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div></div>
    </div>
  </section>

</BaseLayout>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-6);
  }
  .team-grid--supervisors {
    max-width: 440px;
    margin-inline: auto;
  }
  .team-card {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .team-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--sp-4);
  }
  .team-photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-surface-2);
    border: 2px dashed var(--c-border);
    color: var(--c-text-faint);
  }
  .team-photo--placeholder svg { width: 44px; height: 44px; }
  .team-name { color: var(--c-secondary); font-size: 1.05rem; margin-bottom: var(--sp-1); }
  .team-major { font-size: 0.88rem; color: var(--c-text-muted); max-width: none; }

  .attribution-table th:first-child, .attribution-table td:first-child {
    min-width: 260px;
    text-align: left;
  }
  .attribution-desc {
    display: block;
    font-size: 0.82rem;
    color: var(--c-text-muted);
    margin-top: var(--sp-1);
    margin-bottom: var(--sp-2);
    max-width: 42ch;
  }
  .attribution-score { text-align: center; }
</style>
