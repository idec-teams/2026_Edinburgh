    .b4-heading {
      font-size: clamp(2rem, 4.5vw, 3rem);
      font-weight: 400;
      letter-spacing: -0.04em;
      margin-bottom: 48px;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.7s 0.1s, transform 0.7s 0.1s;
    }
