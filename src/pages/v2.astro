    /* ── BEAT 4: Bento grid ─────────────────────────── */
    #beat4 {
      background: #000;
      scroll-snap-align: start;
      padding: 80px 20px;
    }
    @media (min-width: 768px) { #beat4 { padding: 100px 48px; } }
    @media (min-width: 1024px) { #beat4 { padding: 120px 64px; } }

    .b4-container {
      max-width: 1100px;
      margin: 0 auto;
    }
    .b4-eyebrow {
      font-size: 0.6875rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--cv-accent);
      margin-bottom: 16px;
      opacity: 0;
      transform: translateY(12px);
