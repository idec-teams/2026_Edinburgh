---
// Standalone cinematic page — pure vanilla JS, no React.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CxnA — Cinematic</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@1,400;1,500;1,600&display=swap" rel="stylesheet" />

  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = t;
    })();
  </script>

  <style is:inline>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-snap-type: y mandatory; }
    body {
      background: #000;
      color: #fff;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      letter-spacing: -0.02em;
    }

    /* ── Palette variables ──────────────────────────── */
    :root {
      --cv-primary: #3dd68c;
      --cv-accent:  #fbbf24;
    }
    [data-palette="B"] {
      --cv-primary: #34d5b0;
      --cv-accent:  #e8702a;
    }

    /* ── Palette toggle ─────────────────────────────── */
    #palette-toggle {
      position: fixed;
      bottom: 28px;
      right: 24px;
      z-index: 200;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }
    #palette-toggle label {
      font-size: 0.625rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
    }
    .palette-swatches {
      display: flex;
      gap: 6px;
    }
    .palette-swatch {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.25);
      cursor: pointer;
      transition: border-color 0.2s, transform 0.15s;
      position: relative;
      overflow: hidden;
      background: none;
      padding: 0;
    }
    .palette-swatch::before,
    .palette-swatch::after {
      content: '';
      position: absolute;
      inset: 0;
    }
    .palette-swatch::before { clip-path: polygon(0 0, 50% 0, 50% 100%, 0 100%); }
    .palette-swatch::after  { clip-path: polygon(50% 0, 100% 0, 100% 100%, 50% 100%); }
    .swatch-A::before { background: #3dd68c; }
    .swatch-A::after  { background: #fbbf24; }
    .swatch-B::before { background: #34d5b0; }
    .swatch-B::after  { background: #e8702a; }
    .palette-swatch.active { border-color: #fff; transform: scale(1.12); }

    /* ── Fixed Nav ─────────────────────────────────── */
    #lithos-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
    }
    .nav-logo { display: flex; align-items: center; gap: 8px; }
    .nav-logo span { font-size: 1.25rem; font-weight: 600; color: #fff; }
    .nav-pills {
      display: flex;
      align-items: center;
      gap: 4px;
      background: rgba(255,255,255,0.2);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 999px;
      padding: 8px;
    }
    .nav-pill {
      display: inline-block;
      color: rgba(255,255,255,0.8);
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 6px 16px;
      border-radius: 999px;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
    }
    .nav-pill:hover, .nav-pill.active {
      background: rgba(255,255,255,0.2);
      color: #fff;
    }
    .nav-cta {
      background: #fff;
      color: #111;
      border: none;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 10px 24px;
      border-radius: 999px;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
    }
    .nav-cta:hover { background: #e5e5e5; }
    @media (max-width: 767px) { .nav-pills, .nav-cta { display: none; } }

    /* ── Liquid-glass utility ───────────────────────── */
    .liquid-glass {
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.1);
      position: relative;
      overflow: hidden;
    }
    .liquid-glass::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1.4px;
      background: linear-gradient(180deg,
        rgba(255,255,255,0.3) 0%, rgba(255,255,255,0.1) 20%,
        rgba(255,255,255,0) 40%, rgba(255,255,255,0) 60%,
        rgba(255,255,255,0.1) 80%, rgba(255,255,255,0.3) 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    /* ── VEX HERO ───────────────────────────────────── */
    #vex-hero {
      position: relative;
      min-height: 100dvh;
      background: #000;
      overflow: hidden;
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
    }
    #magnet-square {
      position: absolute;
      top: 50%; left: 50%;
      width: min(600px, 90vw);
      height: min(600px, 90vw);
      margin-top: calc(min(600px, 90vw) / -2);
      margin-left: calc(min(600px, 90vw) / -2);
      background:
        linear-gradient(rgba(0,0,12,0.28), rgba(0,0,12,0.28)),
        url('https://images.unsplash.com/photo-1714844437236-de8ef1c7286f?w=1200&q=80') center/cover;
      border-radius: 16px;
      transform: rotate(9deg);
      pointer-events: none;
      will-change: transform;
    }
    .vex-inner-nav {
      padding: 80px 24px 0;
    }
    @media (min-width: 768px) { .vex-inner-nav { padding: 80px 48px 0; } }
    @media (min-width: 1024px) { .vex-inner-nav { padding: 80px 64px 0; } }
    .vex-inner-nav nav {
      border-radius: 12px;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .vex-nav-logo { font-size: 1.5rem; font-weight: 600; }
    .vex-nav-links {
      display: none;
      gap: 32px;
      font-size: 0.875rem;
      list-style: none;
    }
    @media (min-width: 768px) { .vex-nav-links { display: flex; } }
    .vex-nav-links a { color: #fff; text-decoration: none; transition: color 0.2s; }
    .vex-nav-links a:hover { color: rgba(255,255,255,0.6); }
    .vex-nav-cta {
      background: #fff;
      color: #000;
      border: none;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 8px 24px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
    }
    .vex-nav-cta:hover { background: #e5e5e5; }

    .vex-content {
      flex: 1;
      display: flex;
      align-items: flex-end;
      padding: 0 24px 48px;
    }
    @media (min-width: 768px) { .vex-content { padding: 0 48px 64px; } }
    @media (min-width: 1024px) { .vex-content { padding: 0 64px 64px; } }
    .vex-grid {
      width: 100%;
      display: grid;
      gap: 32px;
    }
    @media (min-width: 1024px) {
      .vex-grid { grid-template-columns: 1fr 1fr; align-items: end; }
    }
    .vex-h1 {
      font-size: clamp(2.5rem, 7vw, 5rem);
      font-weight: 400;
      line-height: 1.05;
      letter-spacing: -0.04em;
      margin-bottom: 16px;
    }
    .vex-h1 .char {
      display: inline-block;
      opacity: 0;
      transform: translateX(-18px);
      transition: opacity 500ms, transform 500ms;
    }
    .vex-h1.animated .char { opacity: 1; transform: translateX(0); }

    .vex-para {
      font-size: 1rem;
      color: rgba(255,255,255,0.7);
      margin-bottom: 20px;
      max-width: 40ch;
      opacity: 0;
      transition: opacity 1s;
    }
    @media (min-width: 768px) { .vex-para { font-size: 1.125rem; } }
    .vex-para.visible { opacity: 1; }

    .vex-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      opacity: 0;
      transition: opacity 1s;
    }
    .vex-buttons.visible { opacity: 1; }
    .btn-primary {
      background: #fff;
      color: #000;
      border: none;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 500;
      padding: 12px 32px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    .btn-primary:hover { background: #e5e5e5; }
    .btn-glass {
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 500;
      padding: 12px 32px;
      border-radius: 8px;
      cursor: pointer;
      background: rgba(0,0,0,0.4);
      backdrop-filter: blur(4px);
      transition: background 0.2s, color 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    .btn-glass:hover { background: #fff; color: #000; }

    .vex-pill-wrap {
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      opacity: 0;
      transition: opacity 1s;
    }
    @media (min-width: 1024px) { .vex-pill-wrap { justify-content: flex-end; } }
    .vex-pill-wrap.visible { opacity: 1; }
    .vex-pill {
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 12px;
      padding: 12px 24px;
      font-size: 1.25rem;
      font-weight: 300;
    }
    @media (min-width: 768px) { .vex-pill { font-size: 1.5rem; } }

    /* ── LITHOS HERO ────────────────────────────────── */
    #lithos-hero {
      position: relative;
      width: 100%;
      height: 100dvh;
      background: #000;
      overflow: hidden;
      scroll-snap-align: start;
    }
    #lithos-base {
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1657573100558-c15355cc9c49?w=1920&q=80');
      background-size: cover;
      background-position: center;
      z-index: 1;
    }
    #lithos-reveal {
      position: absolute;
      inset: 0;
      background-image: url('https://images.unsplash.com/photo-1709651808265-977ed7ef78c6?w=1920&q=80');
      background-size: cover;
      background-position: center;
      z-index: 3;
      pointer-events: none;
    }
    #lithos-canvas { position: absolute; inset: 0; display: none; }

    .lithos-heading {
      position: absolute;
      top: 14%;
      left: 0; right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 20px;
      pointer-events: none;
      z-index: 5;
    }
    .lithos-heading h1 {
      color: #fff;
      line-height: 0.95;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .lithos-h-italic {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(3rem, 10vw, 6rem);
      letter-spacing: -0.05em;
      display: block;
    }
    .lithos-h-plain {
      font-weight: 400;
      font-size: clamp(3rem, 10vw, 6rem);
      letter-spacing: -0.08em;
      display: block;
      margin-top: -4px;
    }

    .lithos-bl {
      position: absolute;
      bottom: 56px;
      left: 40px;
      max-width: 260px;
      z-index: 5;
      display: none;
    }
    @media (min-width: 640px) { .lithos-bl { display: block; } }
    .lithos-bl p {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.6;
    }

    .lithos-br {
      position: absolute;
      bottom: 40px;
      right: 20px;
      left: 20px;
      max-width: 260px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      z-index: 5;
    }
    @media (min-width: 640px) {
      .lithos-br { left: auto; right: 56px; bottom: 96px; }
    }
    .lithos-br p {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.8);
      line-height: 1.6;
    }
    .btn-lithos {
      background: var(--cv-accent);
      color: #000;
      border: none;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 12px 28px;
      border-radius: 999px;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s, filter 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    .btn-lithos:hover { filter: brightness(1.1); transform: scale(1.03); }
    .btn-lithos:active { transform: scale(0.95); }

    /* ── Keyframe animations ────────────────────────── */
    @keyframes heroReveal {
      0%   { opacity: 0; transform: translateY(28px); filter: blur(12px); }
      100% { opacity: 1; transform: translateY(0);    filter: blur(0); }
    }
    @keyframes heroFadeUp {
      0%   { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    @keyframes heroZoom {
      0%   { transform: scale(1.12); }
      100% { transform: scale(1); }
    }

    .hero-anim {
      opacity: 0;
      animation-fill-mode: forwards;
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-reveal { animation-name: heroReveal; animation-duration: 1.1s; }
    .hero-fade   { animation-name: heroFadeUp; animation-duration: 1s; }
    .hero-zoom   { animation: heroZoom 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

    @media (prefers-reduced-motion: reduce) {
      .hero-anim, .hero-zoom { animation: none; opacity: 1; }
      .vex-h1 .char { opacity: 1; transform: none; }
    }

    /* ── Theme toggle button ────────────────────────── */
    #v2-theme-toggle {
      background: none;
      border: none;
      cursor: pointer;
      color: #fff;
      padding: 7px;
      display: flex;
      align-items: center;
      border-radius: 8px;
      opacity: 0.75;
      transition: opacity 0.2s, background 0.2s;
    }
    #v2-theme-toggle:hover { opacity: 1; background: rgba(255,255,255,0.12); }
    [data-theme="dark"]  .icon-sun  { display: none; }
    [data-theme="light"] .icon-moon { display: none; }
    [data-theme="light"] #v2-theme-toggle { color: #111; }
    [data-theme="light"] #v2-theme-toggle:hover { background: rgba(0,0,0,0.08); }

    /* ── Light mode overrides ───────────────────────── */
    [data-theme="light"] {
      --cv-primary: #1a6648;
      --cv-accent:  #b5721f;
    }
    [data-theme="light"][data-palette="B"] {
      --cv-primary: #0d7a6a;
      --cv-accent:  #c4561a;
    }

    [data-theme="light"] body { background: #f5f5f0; color: #111; }

    /* Palette toggle */
    [data-theme="light"] #palette-toggle label { color: rgba(0,0,0,0.4); }
    [data-theme="light"] .palette-swatch { border-color: rgba(0,0,0,0.18); }
    [data-theme="light"] .palette-swatch.active { border-color: #111; }

    /* Nav */
    [data-theme="light"] #lithos-nav { background: rgba(245,245,240,0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,0,0,0.08); }
    [data-theme="light"] .nav-logo span { color: #111; }
    [data-theme="light"] .nav-logo svg { fill: #111; }
    [data-theme="light"] .nav-pills { background: rgba(0,0,0,0.05); border-color: rgba(0,0,0,0.12); }
    [data-theme="light"] .nav-pill { color: rgba(0,0,0,0.65); }
    [data-theme="light"] .nav-pill:hover,
    [data-theme="light"] .nav-pill.active { background: rgba(0,0,0,0.08); color: #111; }
    [data-theme="light"] .nav-cta { background: #111; color: #fff; }
    [data-theme="light"] .nav-cta:hover { background: #333; }

    /* Liquid glass (light) */
    [data-theme="light"] .liquid-glass { background: rgba(255,255,255,0.65); box-shadow: inset 0 1px 1px rgba(0,0,0,0.06); }
    [data-theme="light"] .liquid-glass::before {
      background: linear-gradient(180deg,
        rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.02) 20%,
        transparent 40%, transparent 60%,
        rgba(0,0,0,0.02) 80%, rgba(0,0,0,0.08) 100%);
    }

    /* VexHero */
    [data-theme="light"] #vex-hero { background: #f5f5f0; }
    [data-theme="light"] #magnet-square { filter: brightness(1.08) saturate(0.85); }
    [data-theme="light"] .vex-nav-links a { color: #111; }
    [data-theme="light"] .vex-nav-links a:hover { color: rgba(0,0,0,0.45); }
    [data-theme="light"] .vex-nav-cta { background: #111; color: #fff; }
    [data-theme="light"] .vex-nav-cta:hover { background: #333; }
    [data-theme="light"] .vex-para { color: rgba(0,0,0,0.6); }
    [data-theme="light"] .btn-primary { background: #111; color: #fff; }
    [data-theme="light"] .btn-primary:hover { background: #333; }
    [data-theme="light"] .btn-glass { border-color: rgba(0,0,0,0.18); color: #111; background: rgba(255,255,255,0.55); }
    [data-theme="light"] .btn-glass:hover { background: #111; color: #fff; }
    [data-theme="light"] .vex-pill { border-color: rgba(0,0,0,0.15); color: #111; }

    /* Beat 3 */
    [data-theme="light"] #beat3-sticky { background: #f5f5f0; }
    [data-theme="light"] #b3-webp-img,
    [data-theme="light"] #b3-webp-canvas { opacity: 0.18; }
    [data-theme="light"] #b3-webp-img { transition: none; }
    [data-theme="light"] #b3-mol-overlay {
      background: radial-gradient(ellipse at 50% 45%, rgba(245,245,240,0.1) 0%, rgba(245,245,240,0.92) 100%);
    }
    [data-theme="light"] .b3-backbone { stroke: rgba(0,0,0,0.15); }
    [data-theme="light"] .b3-gh10-shape { fill: rgba(26,102,72,0.07); }
    [data-theme="light"] .b3-gh10-shape.lit { filter: drop-shadow(0 0 10px rgba(26,102,72,0.5)); }
    [data-theme="light"] .b3-cbm-shape { fill: rgba(181,114,31,0.07); }
    [data-theme="light"] .b3-cbm-shape.lit { filter: drop-shadow(0 0 8px rgba(181,114,31,0.5)); }
    [data-theme="light"] .b3-gh1-shape { fill: rgba(26,102,72,0.07); }
    [data-theme="light"] .b3-gh1-shape.lit { filter: drop-shadow(0 0 10px rgba(26,102,72,0.5)); }
    [data-theme="light"] .b3-svg-label { fill: rgba(0,0,0,0.5); }
    [data-theme="light"] .b3-svg-domain-name { fill: rgba(0,0,0,0.8); }
    [data-theme="light"] .b3-svg-sublabel { fill: rgba(0,0,0,0.4); }
    [data-theme="light"] .b3-card { border-color: rgba(0,0,0,0.09); background: rgba(255,255,255,0.75); }
    [data-theme="light"] .b3-card-gh10 { border-color: rgba(26,102,72,0.22); }
    [data-theme="light"] .b3-card-cbm  { border-color: rgba(181,114,31,0.22); }
    [data-theme="light"] .b3-card-gh1  { border-color: rgba(26,102,72,0.22); }
    [data-theme="light"] .b3-card p { color: rgba(0,0,0,0.55); }
    [data-theme="light"] .b3-final { color: rgba(0,0,0,0.45); }
    [data-theme="light"] .b3-final strong { color: rgba(0,0,0,0.75); }

    /* Beat 4 */
    [data-theme="light"] #beat4 { background: #f5f5f0; }
    [data-theme="light"] .b4-card { border-color: rgba(0,0,0,0.09); background: rgba(255,255,255,0.7); }
    [data-theme="light"] .b4-card:hover { background: rgba(255,255,255,0.95); border-color: rgba(0,0,0,0.18); }
    [data-theme="light"] .b4-card-title { color: rgba(0,0,0,0.8); }
    [data-theme="light"] .b4-card-arrow { color: rgba(0,0,0,0.28); }
    [data-theme="light"] .b4-card:hover .b4-card-arrow { color: rgba(0,0,0,0.65); }
    [data-theme="light"] .b4-footer p { color: rgba(0,0,0,0.4); }

    /* ── BEAT 3: Mechanism ──────────────────────────── */
    #beat3 {
      height: 300vh;
      scroll-snap-align: start;
    }
    #beat3-sticky {
      position: sticky;
      top: 0;
      height: 100dvh;
      overflow: hidden;
      background: #000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0;
    }
    .b3-eyebrow {
      font-size: 0.6875rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--cv-primary);
      margin-bottom: 20px;
      transition: opacity 0.8s, transform 0.8s;
    }
    .b3-heading {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 400;
      letter-spacing: -0.04em;
      text-align: center;
      line-height: 1.08;
      margin-bottom: 52px;
      transition: opacity 0.8s, transform 0.8s;
    }
    .b3-heading em {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      color: var(--cv-primary);
    }

    /* SVG protein domain diagram */
    .b3-svg-wrap {
      width: min(700px, 90vw);
      margin-bottom: 32px;
      transition: opacity 0.8s;
    }
    .b3-backbone {
      stroke: rgba(255,255,255,0.15);
      stroke-width: 3;
      fill: none;
    }
    .b3-domain {
      fill: none;
      stroke-width: 2.5;
      opacity: 0;
      transition: opacity 0.7s, filter 0.7s;
      filter: drop-shadow(0 0 0px transparent);
    }
    .b3-domain.lit {
      opacity: 1;
    }
    .b3-gh10-shape {
      stroke: var(--cv-primary);
      fill: rgba(61, 214, 140, 0.08);
    }
    .b3-gh10-shape.lit {
      filter: drop-shadow(0 0 14px var(--cv-primary));
    }
    .b3-cbm-shape {
      stroke: var(--cv-accent);
      fill: rgba(251, 191, 36, 0.08);
    }
    .b3-cbm-shape.lit {
      filter: drop-shadow(0 0 10px var(--cv-accent));
    }
    .b3-gh1-shape {
      stroke: var(--cv-primary);
      fill: rgba(61, 214, 140, 0.08);
    }
    .b3-gh1-shape.lit {
      filter: drop-shadow(0 0 14px var(--cv-primary));
    }
    .b3-svg-label {
      fill: rgba(255,255,255,0.5);
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0;
      transition: opacity 0.7s;
    }
    .b3-svg-label.lit { opacity: 1; }
    .b3-svg-sublabel {
      fill: rgba(255,255,255,0.28);
      font-family: 'Inter', sans-serif;
      font-size: 8px;
    }
    .b3-svg-domain-name {
      fill: rgba(255,255,255,0.85);
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    /* Domain info cards below svg */
    .b3-cards {
      display: flex;
      gap: 16px;
      width: min(700px, 90vw);
      transition: opacity 0.8s;
    }
    .b3-card {
      flex: 1;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.08);
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.6s, transform 0.6s;
    }
    .b3-card.lit {
      opacity: 1;
      transform: translateY(0);
    }
    .b3-card-name {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
