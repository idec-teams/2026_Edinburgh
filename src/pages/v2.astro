  <script is:inline>
    // ── Char-by-char heading ────────────────────────────────────
    (function() {
      var el = document.getElementById('vex-heading');
      var text = 'One enzyme.\nThree activities.';
      var CHAR_DELAY = 30;
      var lines = text.split('\n');
      el.innerHTML = lines.map(function(line, li) {
        return '<span class="block">' +
          line.split('').map(function(ch, ci) {
            var delay = (li * line.length * CHAR_DELAY) + (ci * CHAR_DELAY);
            return '<span class="char" style="transition-delay:' + delay + 'ms">' +
              (ch === ' ' ? '&nbsp;' : ch) + '</span>';
          }).join('') +
          '</span>';
      }).join('');
      setTimeout(function() { el.classList.add('animated'); }, 200);
    })();

    // ── Staggered fade-ins (Beat 1) ─────────────────────────────
    (function() {
      var items = [
        { el: document.getElementById('vex-para'),    delay: 800  },
        { el: document.getElementById('vex-buttons'), delay: 1200 },
        { el: document.getElementById('vex-pill'),    delay: 1400 },
      ];
      items.forEach(function(item) {
        setTimeout(function() { item.el.classList.add('visible'); }, item.delay);
      });
    })();

    // ── Magnetic square ─────────────────────────────────────────
    (function() {
      var sq = document.getElementById('magnet-square');
      var near = false;
      var STRENGTH = 20, PAD = 100;
      window.addEventListener('mousemove', function(e) {
        var r = sq.getBoundingClientRect();
        var cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        var isNear = Math.abs(e.clientX - cx) < r.width / 2 + PAD &&
                     Math.abs(e.clientY - cy) < r.height / 2 + PAD;
        if (isNear) {
          near = true;
          sq.style.transition = 'transform 0.3s ease-out';
          sq.style.transform = 'rotate(9deg) translate3d(' +
            ((e.clientX - cx) / STRENGTH) + 'px,' +
            ((e.clientY - cy) / STRENGTH) + 'px,0)';
        } else if (near) {
          near = false;
          sq.style.transition = 'transform 0.6s ease-in-out';
          sq.style.transform = 'rotate(9deg) translate3d(0,0,0)';
        }
      });
    })();

    // ── Lithos spotlight ────────────────────────────────────────
    (function() {
      var section  = document.getElementById('lithos-hero');
      var canvas   = document.getElementById('lithos-canvas');
      var reveal   = document.getElementById('lithos-reveal');
      var RADIUS   = 260;
      var mouse    = { x: -999, y: -999 };
      var smooth   = { x: -999, y: -999 };

      function resize() {
        canvas.width  = section.offsetWidth;
        canvas.height = section.offsetHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      window.addEventListener('mousemove', function(e) {
        var r = section.getBoundingClientRect();
        mouse.x = e.clientX - r.left;
        mouse.y = e.clientY - r.top;
      });

      function tick() {
        smooth.x += (mouse.x - smooth.x) * 0.1;
        smooth.y += (mouse.y - smooth.y) * 0.1;

        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        var g = ctx.createRadialGradient(smooth.x, smooth.y, 0, smooth.x, smooth.y, RADIUS);
        g.addColorStop(0,    'rgba(255,255,255,1)');
        g.addColorStop(0.4,  'rgba(255,255,255,1)');
        g.addColorStop(0.6,  'rgba(255,255,255,0.75)');
        g.addColorStop(0.75, 'rgba(255,255,255,0.4)');
        g.addColorStop(0.88, 'rgba(255,255,255,0.12)');
        g.addColorStop(1,    'rgba(255,255,255,0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(smooth.x, smooth.y, RADIUS, 0, Math.PI * 2);
        ctx.fill();

        var url = canvas.toDataURL();
        reveal.style.maskImage        = 'url(' + url + ')';
        reveal.style.webkitMaskImage  = 'url(' + url + ')';
        reveal.style.maskSize         = '100% 100%';
        reveal.style.webkitMaskSize   = '100% 100%';

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    })();

    // ── Beat 3: scroll-driven domain reveal ─────────────────────
    (function() {
      var section = document.getElementById('beat3');
      var eyebrow = document.getElementById('b3-eyebrow');
      var heading = document.getElementById('b3-heading');
      var svgWrap = document.getElementById('b3-svg-wrap');
      var gh10Dom = document.getElementById('b3-gh10-dom');
      var gh10Helix = document.getElementById('b3-gh10-helix');
      var labGh10 = document.getElementById('b3-lab-gh10');
      var labGh10Sub = document.getElementById('b3-lab-gh10-sub');
      var cbmDom  = document.getElementById('b3-cbm-dom');
      var labCbm  = document.getElementById('b3-lab-cbm');
      var labCbmSub = document.getElementById('b3-lab-cbm-sub');
      var gh1Dom  = document.getElementById('b3-gh1-dom');
      var gh1Helix = document.getElementById('b3-gh1-helix');
      var labGh1  = document.getElementById('b3-lab-gh1');
      var labGh1Sub = document.getElementById('b3-lab-gh1-sub');
      var cardGh10 = document.getElementById('b3-card-gh10');
      var cardCbm  = document.getElementById('b3-card-cbm');
      var cardGh1  = document.getElementById('b3-card-gh1');
      var final    = document.getElementById('b3-final');

      function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }
      function mapRange(v, i0, i1, o0, o1) {
        return o0 + (o1 - o0) * clamp((v - i0) / (i1 - i0), 0, 1);
      }

      var state = { gh10: false, cbm: false, gh1: false, final: false };

      function lit(el, on) {
        if (on) el.classList.add('lit');
        else    el.classList.remove('lit');
      }

      function tick() {
        var rect = section.getBoundingClientRect();
        var totalScroll = section.offsetHeight - window.innerHeight;
        var p = clamp(-rect.top / totalScroll, 0, 1);

        // Eyebrow + heading: 0–0.15
        var headOp = mapRange(p, 0, 0.12, 0, 1);
        eyebrow.style.opacity = headOp;
        eyebrow.style.transform = 'translateY(' + mapRange(p, 0, 0.12, 16, 0) + 'px)';
        heading.style.opacity = headOp;
        heading.style.transform = 'translateY(' + mapRange(p, 0, 0.12, 20, 0) + 'px)';

        // SVG fades in: 0.05–0.2
        svgWrap.style.opacity = mapRange(p, 0.05, 0.2, 0, 1);

        // GH10: 0.2–0.45
        var gh10On = p >= 0.2;
        if (gh10On !== state.gh10) {
          state.gh10 = gh10On;
          lit(gh10Dom, gh10On);
          lit(labGh10, gh10On);
          lit(labGh10Sub, gh10On);
          lit(cardGh10, gh10On);
          gh10Helix.style.opacity = gh10On ? '1' : '0';
        }

        // CBM: 0.45–0.65
        var cbmOn = p >= 0.45;
        if (cbmOn !== state.cbm) {
          state.cbm = cbmOn;
          lit(cbmDom, cbmOn);
          lit(labCbm, cbmOn);
          lit(labCbmSub, cbmOn);
          lit(cardCbm, cbmOn);
        }

        // GH1: 0.65–0.85
        var gh1On = p >= 0.65;
        if (gh1On !== state.gh1) {
          state.gh1 = gh1On;
          lit(gh1Dom, gh1On);
          lit(labGh1, gh1On);
          lit(labGh1Sub, gh1On);
          lit(cardGh1, gh1On);
          gh1Helix.style.opacity = gh1On ? '1' : '0';
        }

        // Final text: 0.85–1.0
        var finalOp = mapRange(p, 0.85, 1.0, 0, 1);
        final.style.opacity = finalOp;

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    })();

    // ── Beat 4: stagger reveal on scroll ───────────────────────
    (function() {
      var eyebrow = document.getElementById('b4-eyebrow');
      var heading = document.getElementById('b4-heading');
      var footer  = document.getElementById('b4-footer');
      var cards   = document.querySelectorAll('.b4-card');

      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          var delay = parseInt(el.dataset.b4Delay || '0', 10);
          setTimeout(function() { el.classList.add('visible'); }, delay);
          io.unobserve(el);
        });
      }, { threshold: 0.15 });

      var headerIo = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          eyebrow.classList.add('visible');
          heading.classList.add('visible');
          footer.classList.add('visible');
          headerIo.disconnect();
        });
      }, { threshold: 0.2 });

      headerIo.observe(document.getElementById('beat4'));
      cards.forEach(function(card) { io.observe(card); });
    })();

    // ── Light/dark theme toggle ─────────────────────────────────
    (function() {
      var btn = document.getElementById('v2-theme-toggle');
      function applyTheme(t) {
        document.documentElement.dataset.theme = t;
        localStorage.setItem('theme', t);
      }
      btn.addEventListener('click', function() {
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    })();

    // ── Beat 3: scroll-scrubbed WebP background ─────────────────
    (function() {
      var WEBP_URL = '/cxna-site/helix-spin.webp';
      var section = document.getElementById('beat3');
      var imgEl   = document.getElementById('b3-webp-img');
      var canvas  = document.getElementById('b3-webp-canvas');
      if (!canvas) return;

      var ctx = canvas.getContext('2d');
      var frames = [];
      var scrubReady = false;

      function clampF(v, a, b) { return Math.max(a, Math.min(b, v)); }

      // Size canvas to viewport
      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      // Draw frame with object-fit: cover semantics
      function drawCover(frame) {
        var cw = canvas.width, ch = canvas.height;
        var fW = frame.width,  fH = frame.height;
        var ca = cw / ch, fa = fW / fH;
        var sx = 0, sy = 0, sw = fW, sh = fH;
        if (ca > fa) { sh = fW / ca; sy = (fH - sh) / 2; }
        else         { sw = fH * ca; sx = (fW - sw) / 2; }
        ctx.drawImage(frame, sx, sy, sw, sh, 0, 0, cw, ch);
      }

      // Sequential frame decode using ImageDecoder
      function decodeAll(decoder, total, idx, bitmaps, done) {
        if (idx >= total) { done(bitmaps); return; }
        decoder.decode({ frameIndex: idx })
          .then(function(result) {
            return createImageBitmap(result.image).then(function(bmp) {
              result.image.close();
              bitmaps.push(bmp);
              decodeAll(decoder, total, idx + 1, bitmaps, done);
            });
          })
          .catch(function() { done(bitmaps); });
      }

      if (typeof window.ImageDecoder !== 'undefined') {
        fetch(WEBP_URL)
          .then(function(r) { return r.arrayBuffer(); })
          .then(function(buf) {
            var dec = new window.ImageDecoder({ data: buf, type: 'image/webp' });
            return dec.tracks.ready.then(function() {
              var track = dec.tracks.selectedTrack;
              var total = (track && track.frameCount) || 0;
              if (total <= 1) { dec.close(); return; }
              decodeAll(dec, total, 0, [], function(bitmaps) {
                if (bitmaps.length > 1) {
                  frames = bitmaps;
                  scrubReady = true;
                  canvas.style.opacity = '0.55';
                  imgEl.style.opacity  = '0';
                }
                dec.close();
              });
            });
          })
          .catch(function(e) { console.warn('[Beat3 WebP]', e); });
      }

      // RAF: draw frame matching scroll progress
      var lastIdx = -1;
      function tickWebp() {
        if (scrubReady && frames.length > 0) {
          var rect = section.getBoundingClientRect();
          var totalScroll = section.offsetHeight - window.innerHeight;
          var p   = clampF(-rect.top / totalScroll, 0, 1);
          var idx = clampF(Math.round(p * (frames.length - 1)), 0, frames.length - 1);
          if (idx !== lastIdx) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            if (frames[idx]) drawCover(frames[idx]);
            lastIdx = idx;
          }
        }
        requestAnimationFrame(tickWebp);
      }
      tickWebp();
    })();

    // ── Palette toggle ──────────────────────────────────────────
    (function() {
      var swatches = document.querySelectorAll('.palette-swatch');
      var current = 'A';
      swatches.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var pal = btn.dataset.pal;
          if (pal === current) return;
          current = pal;
          if (pal === 'B') {
            document.documentElement.dataset.palette = 'B';
          } else {
            delete document.documentElement.dataset.palette;
          }
          swatches.forEach(function(b) {
            var isActive = b.dataset.pal === pal;
            b.classList.toggle('active', isActive);
            b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
        });
      });
    })();
  </script>
</body>
</html>
