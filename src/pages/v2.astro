    .b3-card-gh10 .b3-card-name { color: var(--cv-primary); }
    .b3-card-cbm  { border-color: rgba(251, 191, 36, 0.25); }
    .b3-card-cbm  .b3-card-name { color: var(--cv-accent); }
    .b3-card-gh1  { border-color: rgba(61, 214, 140, 0.25); }
    .b3-card-gh1  .b3-card-name { color: var(--cv-primary); }
    .b3-card p {
      font-size: 0.75rem;
      color: rgba(255,255,255,0.5);
      line-height: 1.5;
    }

    .b3-final {
      margin-top: 28px;
      font-size: 0.875rem;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.02em;
      text-align: center;
      transition: opacity 0.8s;
    }
    .b3-final strong { color: rgba(255,255,255,0.75); }

    /* ── Beat 3 WebP scroll-scrub background ────────── */
    #b3-webp-img,
    #b3-webp-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
      z-index: 0;
    }
    #b3-webp-img {
      opacity: 0.55;
      transition: opacity 0.4s ease;
    }
    #b3-webp-canvas {
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    #b3-mol-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 45%, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.82) 100%);
      z-index: 1;
      pointer-events: none;
